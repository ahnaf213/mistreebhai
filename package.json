{
  "name": "mistreebhai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "server": "node server/server.js",
    "dev:full": "concurrently -k -n api,web \"npm:server\" \"npm:dev\"",
    "start": "node server/server.js",
    "db:setup": "node server/run-schema.js",
    "check:server": "node --check server/server.js && node --check server/run-schema.js && node --check \"api/[...route].js\"",
    "test:config": "node --test tests/*.test.js",
    "test": "npm run check:server && npm run test:config"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "cors": "^2.8.5",
    "bcryptjs": "^3.0.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
