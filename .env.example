# Vercel project environment variables (set in Vercel Dashboard, not committed)
# Use a managed PostgreSQL provider such as Neon; use its pooled connection string where recommended.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_SSL=true
NODE_ENV=production
# Exact origin of your deployed Vercel site. For preview deployments add their origins or use separate envs.
CLIENT_ORIGIN=https://your-project.vercel.app
# Generate a unique secret: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=2h
# Temporary one-time admin bootstrap secret. Remove immediately after creating the first admin.
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-one-time-secret
# Frontend calls same-origin Vercel functions by default. Do not set VITE_API_URL unless using a separate API host.
# VITE_API_URL=/api
